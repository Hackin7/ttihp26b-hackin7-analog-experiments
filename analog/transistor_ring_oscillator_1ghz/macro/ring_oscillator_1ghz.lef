        RECT 7.000 2.250 7.685 2.580 ;
        RECT 9.880 2.250 10.565 2.580 ;
        RECT 12.760 2.250 13.445 2.580 ;
        RECT 4.460 2.060 4.805 2.250 ;
        RECT 7.340 2.060 7.685 2.250 ;
        RECT 10.220 2.060 10.565 2.250 ;
        RECT 13.100 2.060 13.445 2.250 ;
        RECT 4.460 1.140 4.805 1.320 ;
        RECT 7.340 1.140 7.685 1.320 ;
        RECT 10.220 1.140 10.565 1.320 ;
        RECT 13.100 1.140 13.445 1.320 ;
      LAYER Metal1 ;
        RECT 2.000 2.495 2.230 3.905 ;
        RECT 4.120 2.495 4.435 2.580 ;
        RECT 2.000 2.335 4.435 2.495 ;
        RECT 2.000 1.340 2.230 2.335 ;
        RECT 4.120 2.250 4.435 2.335 ;
        RECT 4.880 2.495 5.110 3.905 ;
        RECT 7.000 2.495 7.315 2.580 ;
