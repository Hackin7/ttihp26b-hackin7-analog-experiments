VERSION 5.7 ;
NOWIREEXTENSIONATPIN ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
MACRO ring_oscillator_1ghz
  CLASS BLOCK ;
  FOREIGN ring_oscillator_1ghz 0.000 0.000 ;
  ORIGIN 0.000 0.000 ;
  SIZE 16.130 BY 5.330 ;
  PIN out
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER Metal1 ;
        RECT 13.520 2.130 14.520 3.130 ;
    END
  END out
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal1 ;
        RECT 0.930 4.290 15.330 4.730 ;
      LAYER TopMetal1 ;
        RECT 0.000 3.690 2.200 5.330 ;
    END
  END VPWR
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal1 ;
        RECT 0.930 0.510 15.330 0.950 ;
      LAYER TopMetal1 ;
        RECT 13.930 0.000 16.130 1.640 ;
    END
  END VGND
