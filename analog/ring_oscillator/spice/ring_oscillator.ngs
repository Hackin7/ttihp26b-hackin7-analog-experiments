* dd_ring_oscillator_testbench.ngs
* TT IHP SG13G2 ring-oscillator analog macro - ngspice cookbook
*
* Design: ring_oscillator (3-stage: inv, inv, nand2-gate enable)
* Run:    ngspice -b ring_oscillator.ngs   (in the OSIC container)
*
* The macro is authored as an analog xschem schematic (not Verilog) so the
* certain properties below describe the SG13G2 stdcell pin contract in SPICE.
* After harden (librelane MACROS) the GDS/LEF/nl come from this SPICE view.

* ---------------------------------------------------------------
* SG13G2 primitives expressed behaviourally in terms of PDK timing
* so the ring has a realistic oscillation frequency BEFORE layout.
* Replace with the real sg13g2_* subckts from the IHP PDK SPICE
* models as soon as they are staged in this project (analog/spice).
* ---------------------------------------------------------------

* standard-cell timing targets (IHP SG13G2, 1.2V, TT):
*   inv rise/fall delay   ~ 90 ps
*   nand2 (en-gate) delay ~ 110 ps
*   buf  delay            ~ 70 ps
*   => stage delay avg Td ~ 80 ps, ring period = 2*N*Td, N=3 stages (odd gate
*      count includes the NAND; the NAND input "enable" is static during run)

.model dly_stage (td=90p)   * generic; we use real gate subckts below

* --- behavioural SG13G2 inverter (single logical stage) ---
.subckt sg13g2_inv_m a vpwr vgnd y
* delay-only model; full transistor + gate-cap models come from PDK PHY
r_in  a n1  1e6         ; isolate input loading (light)
c_in  n1 vgnd 2.3f     ; SG13G2 inv input cap (~2.3fF)
b_out y vgnd v={( (a>0.6) ? 0.0+vgnd : vpwr )} td=60p ; inverting transfer
.ends sg13g2_inv_m

* --- behavioural SG13G2 NAND2 (enable + ring feedback) ---
.subckt sg13g2_nand2_m a b vpwr vgnd y
c_in_a a vgnd 2. Quarterlyf
c_in_b b vgnd 2.2f
b_out y vgnd v={( (a>0.6)&&(b>0.6) ? 0.0+vgnd : vpwr )} td=70p
.ends sg13g2_nand2_m

* --- behavioural SG13G2 buffer ---
.subckt sg13g2_buf_m a vpwr vgnd y
c_in a vgnd 2.3f
b_out y vgnd v={(a>0.6 ? vpwr : 0.0+vgnd)} td=40p
.ends sg13g2_buf_m

* ---------------------------------------------------------
* RING: p0 --NAND-- n0 --> inv_1 -- n1 --> inv_2 -- n2 --> NAND(p0)
*   NAND enable held at VPWR during oscillation
*   final tap n1 -> buf -> clk_out
* ---------------------------------------------------------
.subckt ring_osc thp tvp xin xout
xnand xin n2 tvp thp n0 sg13g2_nand2_m   ; stage C (enable gate = stage1)
xinv1 n0 tvp thp n1 sg13g2_inv_m        ; stage A
xinv2 n1 tvp thp n2 sg13g2_inv_m        ; stage B
xbuf  n1 tvp thp xout sg13g2_buf_m      ; tap-out buffer
.ends ring_osc

* --- top-level ---
* pin order of ring_osc macro (matches future DEF/LEF):
*   xin(enable) xout(clk_out)  [power: VPWR/VGND in macro]
VDD VPWR 0 1.2
VGND VGND 0 0
VCLK_RING_CTRL xin 0 1.2        ; enable = high

XROC xin clk_out ring_osc

Cpad1 clk_out 0 50f ; output load (external cap)

.control
  tran 0.1n 300n uic
  setplot tran
  print v(clk_out) > /dev/null
  * measure rising-edge periods
  meas tran t1 when v(clk_out)=0.6 rise=3
  meas tran t2 when v(clk_out)=0.6 rise=13
  meas tran period_macro param='(t2-t1)/10'
  meas tran freq_macro param='1/period_macro'
  write ring_osc_results.txt v(clk_out)
  echo "== RING ROTOR FREQUENCY =="
  echo "== period_macro:"
  echo $&period_macro
  echo "== freq_macro:"
  echo $&freq_macro
.endc
.end
